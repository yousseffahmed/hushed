[debug] [2026-05-04T23:18:56.142Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/yushef-b3534/rulesets {"name":"projects/yushef-b3534/rulesets/a44a882d-ae43-485f-98e6-6c6c7fb90c4e","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function allowedUser() {\n      return signedIn()\n        && request.auth.uid in [\n          \"xLUPD71OGYfG4NByDz0buh8ZIsy2\",\n          \"orPQHip5ooOtfSSkyLYhl5hx9Kg1\"\n        ];\n    }\n\n    match /couples/{coupleId} {\n      allow read: if allowedUser();\n\n      match /monthversaries/{memoryId} {\n        allow read, create, update, delete: if allowedUser();\n      }\n\n      match /nudges/{nudgeId} {\n        allow read: if allowedUser();\n        allow create: if allowedUser()\n          && request.resource.data.fromUserId == request.auth.uid\n          && request.resource.data.toUserId in [\n            \"xLUPD71OGYfG4NByDz0buh8ZIsy2\",\n            \"orPQHip5ooOtfSSkyLYhl5hx9Kg1\"\n          ]\n          && request.resource.data.toUserId != request.auth.uid;\n        allow update: if allowedUser()\n          && resource.data.toUserId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"readAt\"]);\n        allow delete: if false;\n      }\n\n      match /suggestions/{suggestionId} {\n        allow read: if allowedUser();\n        allow create: if allowedUser()\n          && request.resource.data.createdBy == request.auth.uid\n          && request.resource.data.createdByName is string\n          && request.resource.data.message is string\n          && request.resource.data.message.size() > 0;\n        allow update: if allowedUser()\n          && request.resource.data.createdBy == resource.data.createdBy\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"likedBy\",\n            \"done\",\n            \"doneAt\"\n          ]);\n        allow delete: if allowedUser()\n          && resource.data.createdBy == request.auth.uid;\n      }\n\n      match /notificationTokens/{userId}/tokens/{tokenId} {\n        allow read, create, update, delete: if allowedUser()\n          && request.auth.uid == userId;\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-04T23:18:56.066799Z","metadata":{"services":["cloud.firestore"]}}
