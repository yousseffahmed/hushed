[debug] [2026-05-07T13:56:39.876Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/yushef-b3534/rulesets {"name":"projects/yushef-b3534/rulesets/e6927b53-8793-4d52-8a87-76511b15490d","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function allowedUser() {\n      return signedIn()\n        && request.auth.uid in [\n          \"xLUPD71OGYfG4NByDz0buh8ZIsy2\",\n          \"orPQHip5ooOtfSSkyLYhl5hx9Kg1\"\n        ];\n    }\n\n    match /couples/{coupleId} {\n      allow read: if allowedUser();\n\n      match /monthversaries/{memoryId} {\n        allow read, create, update, delete: if allowedUser();\n      }\n\n      match /nudges/{nudgeId} {\n        allow read: if allowedUser();\n        allow create: if allowedUser()\n          && request.resource.data.fromUserId == request.auth.uid\n          && request.resource.data.toUserId in [\n            \"xLUPD71OGYfG4NByDz0buh8ZIsy2\",\n            \"orPQHip5ooOtfSSkyLYhl5hx9Kg1\"\n          ]\n          && request.resource.data.toUserId != request.auth.uid;\n        allow update: if allowedUser()\n          && resource.data.toUserId == request.auth.uid\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"readAt\"]);\n        allow delete: if false;\n      }\n\n      match /suggestions/{suggestionId} {\n        allow read: if allowedUser();\n        allow create: if allowedUser()\n          && request.resource.data.createdBy == request.auth.uid\n          && request.resource.data.createdByName is string\n          && request.resource.data.message is string\n          && request.resource.data.message.size() > 0;\n        allow update: if allowedUser()\n          && request.resource.data.createdBy == resource.data.createdBy\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n            \"likedBy\",\n            \"done\",\n            \"doneAt\"\n          ]);\n        allow delete: if allowedUser()\n          && resource.data.createdBy == request.auth.uid;\n      }\n\n      match /theaterItems/{itemId} {\n        allow read: if allowedUser();\n        allow create: if allowedUser()\n          && request.resource.data.addedByUid == request.auth.uid\n          && request.resource.data.title is string\n          && request.resource.data.title.size() > 0;\n        allow update, delete: if allowedUser();\n\n        match /comments/{commentId} {\n          allow read: if allowedUser();\n          allow create: if allowedUser()\n            && request.resource.data.uid == request.auth.uid\n            && request.resource.data.text is string\n            && request.resource.data.text.size() > 0;\n          allow update: if allowedUser()\n            && resource.data.uid == request.auth.uid\n            && request.resource.data.uid == resource.data.uid;\n          allow delete: if allowedUser()\n            && resource.data.uid == request.auth.uid;\n        }\n      }\n\n      match /theaterSession/{sessionId} {\n        allow read, create, update, delete: if allowedUser();\n      }\n\n      match /games/{gameId} {\n        allow read: if allowedUser();\n\n        match /rounds/{roundId} {\n          allow read: if allowedUser();\n          allow create: if allowedUser()\n            && request.resource.data.createdByUid == request.auth.uid;\n          allow update: if allowedUser()\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n              \"players\",\n              \"status\",\n              \"currentTurnUid\",\n              \"updatedAt\"\n            ]);\n          allow delete: if allowedUser();\n\n          match /secrets/{userId} {\n            allow read, delete: if allowedUser()\n              && request.auth.uid == userId;\n            allow create, update: if allowedUser()\n              && request.auth.uid == userId\n              && request.resource.data.uid == request.auth.uid\n              && request.resource.data.secretNumber is string\n              && request.resource.data.secretNumber.matches(\"^[0-9]{4}$\");\n          }\n\n          match /guesses/{guessId} {\n            allow read: if allowedUser();\n            allow create, update, delete: if false;\n          }\n        }\n\n        match /scores/{userId} {\n          allow read: if allowedUser();\n          allow create, update, delete: if false;\n        }\n      }\n\n      match /notificationTokens/{userId}/tokens/{tokenId} {\n        allow read, create, update, delete: if allowedUser()\n          && request.auth.uid == userId;\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-07T13:56:39.791807Z","metadata":{"services":["cloud.firestore"]}}
