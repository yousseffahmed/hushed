rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedUser() {
      return signedIn()
        && request.auth.uid in [
          "xLUPD71OGYfG4NByDz0buh8ZIsy2",
          "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
        ];
    }

    function apologyLetterScope(coupleId, letterId) {
      return coupleId == "yushef"
        && letterId == "apology-shosho-2026-08-31";
    }

    function validApologyCommitment(commitment) {
      return commitment is string && commitment.size() <= 500;
    }

    function validApologyCommitments(commitments) {
      return commitments is list
        && commitments.size() >= 1
        && commitments.size() <= 6
        && validApologyCommitment(commitments[0])
        && (commitments.size() < 2 || validApologyCommitment(commitments[1]))
        && (commitments.size() < 3 || validApologyCommitment(commitments[2]))
        && (commitments.size() < 4 || validApologyCommitment(commitments[3]))
        && (commitments.size() < 5 || validApologyCommitment(commitments[4]))
        && (commitments.size() < 6 || validApologyCommitment(commitments[5]));
    }

    function validApologyDraft(data) {
      return data.keys().hasAll([
          "id",
          "type",
          "fromUid",
          "fromName",
          "toUid",
          "toName",
          "title",
          "apology",
          "shouldHaveDone",
          "whatImChanging",
          "commitments",
          "status",
          "publishedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "id",
          "type",
          "fromUid",
          "fromName",
          "toUid",
          "toName",
          "title",
          "apology",
          "shouldHaveDone",
          "whatImChanging",
          "commitments",
          "status",
          "publishedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.id == "apology-shosho-2026-08-31"
        && data.type == "apology"
        && data.fromUid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
        && data.fromName == "Yuyu"
        && data.toUid == "xLUPD71OGYfG4NByDz0buh8ZIsy2"
        && data.toName == "Shosho"
        && data.title == "For Shosho — I’m Sorry"
        && data.apology is string
        && data.apology.size() <= 12000
        && data.shouldHaveDone is string
        && data.shouldHaveDone.size() <= 8000
        && data.whatImChanging is string
        && data.whatImChanging.size() <= 8000
        && validApologyCommitments(data.commitments)
        && data.status == "draft"
        && data.publishedAt == null
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function special19thScope(coupleId, eventId) {
      return coupleId == "yushef" && eventId == "2026-08-19";
    }

    function special19thEventPath(coupleId, eventId) {
      return /databases/$(database)/documents/couples/$(coupleId)/special19ths/$(eventId);
    }

    function special19thExpectedName(uid) {
      return uid == "xLUPD71OGYfG4NByDz0buh8ZIsy2" ? "Shosho" : "Yuyu";
    }

    function special19thEventExists(coupleId, eventId) {
      return exists(special19thEventPath(coupleId, eventId));
    }

    function special19thRevealReached(coupleId, eventId) {
      let eventPath = special19thEventPath(coupleId, eventId);
      return exists(eventPath)
        && get(eventPath).data.revealAt is timestamp
        && request.time >= get(eventPath).data.revealAt;
    }

    function special19thRevealNotStarted(coupleId, eventId) {
      let eventPath = special19thEventPath(coupleId, eventId);
      return exists(eventPath) && get(eventPath).data.revealAt == null;
    }

    function validInitialSpecial19thStatus(status, uid) {
      return status is map
        && status.keys().hasAll(["ownerName", "sealed", "sealedAt"])
        && status.keys().hasOnly(["ownerName", "sealed", "sealedAt"])
        && status.ownerName == special19thExpectedName(uid)
        && status.sealed == false
        && status.sealedAt == null;
    }

    function validInitialSpecial19thEvent(data) {
      let statusKeys = data.packageStatuses.keys();
      return data.keys().hasAll([
          "id",
          "eventDate",
          "title",
          "packageStatuses",
          "revealStartedAt",
          "revealAt",
          "revealStartedByUid",
          "memoryCreated",
          "memoryId",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "id",
          "eventDate",
          "title",
          "packageStatuses",
          "revealStartedAt",
          "revealAt",
          "revealStartedByUid",
          "memoryCreated",
          "memoryId",
          "createdAt",
          "updatedAt"
        ])
        && data.id == "2026-08-19"
        && data.eventDate == "2026-08-19"
        && data.title == "Our First 19th Apart"
        && data.packageStatuses is map
        && statusKeys.hasAll([
          "xLUPD71OGYfG4NByDz0buh8ZIsy2",
          "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
        ])
        && statusKeys.hasOnly([
          "xLUPD71OGYfG4NByDz0buh8ZIsy2",
          "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
        ])
        && validInitialSpecial19thStatus(
          data.packageStatuses["xLUPD71OGYfG4NByDz0buh8ZIsy2"],
          "xLUPD71OGYfG4NByDz0buh8ZIsy2"
        )
        && validInitialSpecial19thStatus(
          data.packageStatuses["orPQHip5ooOtfSSkyLYhl5hx9Kg1"],
          "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
        )
        && data.revealStartedAt == null
        && data.revealAt == null
        && data.revealStartedByUid == null
        && data.memoryCreated == false
        && data.memoryId == null
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validSpecial19thPackagePath(path, coupleId, eventId, uid, mediaType) {
      return path == null
        || (
          path is string
          && path.matches(
            "^couples/" + coupleId + "/special19ths/" + eventId
              + "/packages/" + uid + "/" + mediaType + "/[^/]+$"
          )
        );
    }

    function validSpecial19thDraft(data, coupleId, eventId, uid) {
      return data.keys().hasAll([
          "ownerUid",
          "ownerName",
          "letter",
          "wish",
          "loveThisMonth",
          "photoStoragePath",
          "photoFileName",
          "voiceNoteStoragePath",
          "voiceNoteFileName",
          "voiceNoteContentType",
          "sealed",
          "sealedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "ownerUid",
          "ownerName",
          "letter",
          "wish",
          "loveThisMonth",
          "photoStoragePath",
          "photoFileName",
          "voiceNoteStoragePath",
          "voiceNoteFileName",
          "voiceNoteContentType",
          "sealed",
          "sealedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.ownerUid == uid
        && data.ownerName == special19thExpectedName(uid)
        && data.letter is string
        && data.letter.size() <= 10000
        && data.wish is string
        && data.wish.size() <= 2000
        && data.loveThisMonth is string
        && data.loveThisMonth.size() <= 2000
        && validSpecial19thPackagePath(
          data.photoStoragePath,
          coupleId,
          eventId,
          uid,
          "photo"
        )
        && (data.photoFileName == null || (data.photoFileName is string && data.photoFileName.size() <= 255))
        && validSpecial19thPackagePath(
          data.voiceNoteStoragePath,
          coupleId,
          eventId,
          uid,
          "voice"
        )
        && (data.voiceNoteFileName == null || (data.voiceNoteFileName is string && data.voiceNoteFileName.size() <= 255))
        && (data.voiceNoteContentType == null || (data.voiceNoteContentType is string && data.voiceNoteContentType.size() <= 100))
        && data.sealed == false
        && data.sealedAt == null
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validSpecial19thPresence(data, uid) {
      return data.keys().hasAll(["uid", "name", "online", "lastSeenAt"])
        && data.keys().hasOnly(["uid", "name", "online", "lastSeenAt"])
        && data.uid == uid
        && data.name == special19thExpectedName(uid)
        && data.online is bool
        && data.lastSeenAt == request.time;
    }

    function otherSpecial19thMomentMissing(coupleId, eventId, uid) {
      return (
          uid == "xLUPD71OGYfG4NByDz0buh8ZIsy2"
          && !exists(
            /databases/$(database)/documents/couples/$(coupleId)/special19ths/$(eventId)/momentPhotos/orPQHip5ooOtfSSkyLYhl5hx9Kg1
          )
        )
        || (
          uid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
          && !exists(
            /databases/$(database)/documents/couples/$(coupleId)/special19ths/$(eventId)/momentPhotos/xLUPD71OGYfG4NByDz0buh8ZIsy2
          )
        );
    }

    function validSpecial19thMoment(data, coupleId, eventId, uid) {
      return data.keys().hasAll([
          "uid",
          "name",
          "storagePath",
          "url",
          "fileName",
          "submittedAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "uid",
          "name",
          "storagePath",
          "url",
          "fileName",
          "submittedAt",
          "updatedAt"
        ])
        && data.uid == uid
        && data.name == special19thExpectedName(uid)
        && data.storagePath is string
        && data.storagePath.matches(
          "^couples/" + coupleId + "/special19ths/" + eventId
            + "/momentPhotos/" + uid + "/[^/]+$"
        )
        && data.url is string
        && data.url.size() > 0
        && data.url.size() <= 4000
        && data.url.matches("^https://firebasestorage[.]googleapis[.]com/.*")
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 255
        && data.submittedAt is timestamp
        && data.updatedAt == request.time;
    }

    function validOwnTheaterReadiness(data) {
      let readyUsers = data.get("readyUsers", {});
      let ownReadiness = readyUsers.get(request.auth.uid, {});
      return readyUsers is map
        && (
          !readyUsers.keys().hasAny([request.auth.uid])
          || (
            ownReadiness is map
            && ownReadiness.ready is bool
            && ownReadiness.name is string
            && (ownReadiness.readyAt is timestamp || ownReadiness.readyAt == null)
          )
        );
    }

    // Wedding moments: shared story fields, immutable authorship, private-to-author note edits.
    function weddingName(uid) {
      return uid == "xLUPD71OGYfG4NByDz0buh8ZIsy2" ? "Shosho" : "Yuyu";
    }

    function weddingDate(value) {
      return value == null || (value is string
        && value.matches('(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10])).day() == int(value[8:10]));
    }

    function weddingNote(note) {
      return note is map && note.keys().hasAll(['text', 'updatedAt'])
        && note.keys().hasOnly(['text', 'updatedAt'])
        && note.text is string && note.text.size() <= 4000 && note.updatedAt is timestamp;
    }

    function weddingNotes(notes) {
      return notes is map
        && notes.keys().hasOnly(['xLUPD71OGYfG4NByDz0buh8ZIsy2', 'orPQHip5ooOtfSSkyLYhl5hx9Kg1'])
        && (!('xLUPD71OGYfG4NByDz0buh8ZIsy2' in notes) || weddingNote(notes.xLUPD71OGYfG4NByDz0buh8ZIsy2))
        && (!('orPQHip5ooOtfSSkyLYhl5hx9Kg1' in notes) || weddingNote(notes.orPQHip5ooOtfSSkyLYhl5hx9Kg1));
    }

    function weddingPhoto(photo, prefix) {
      // Accessing each field below enforces presence; matches enforces string types.
      return photo.keys().hasOnly(['id', 'storagePath', 'url'])
        && photo.id.matches('[a-zA-Z0-9]{20}')
        && photo.storagePath.matches(prefix + photo.id + '-[a-zA-Z0-9._-]{1,120}')
        && photo.url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]{1,100}/o/[^/]{1,900}[?].{1,200}');
    }

    function weddingPhotos(photos, id) {
      let prefix = 'couples/yushef/weddingTimeline/' + id + '/';
      return photos is list && photos.size() <= 10
        && (photos.size() < 1 || weddingPhoto(photos[0], prefix))
        && (photos.size() < 2 || weddingPhoto(photos[1], prefix))
        && (photos.size() < 3 || weddingPhoto(photos[2], prefix))
        && (photos.size() < 4 || weddingPhoto(photos[3], prefix))
        && (photos.size() < 5 || weddingPhoto(photos[4], prefix))
        && (photos.size() < 6 || weddingPhoto(photos[5], prefix))
        && (photos.size() < 7 || weddingPhoto(photos[6], prefix))
        && (photos.size() < 8 || weddingPhoto(photos[7], prefix))
        && (photos.size() < 9 || weddingPhoto(photos[8], prefix))
        && (photos.size() < 10 || weddingPhoto(photos[9], prefix));
    }

    function validWeddingMoment(data, id) {
      let fields = ['id', 'title', 'subtitle', 'description', 'eventDate', 'plannedDate', 'status', 'type',
        'createdByUid', 'createdByName', 'photos', 'notesByUid', 'deleting', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && id.matches('[a-zA-Z0-9]{20}') && data.id == id
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.subtitle is string && data.subtitle.size() <= 240
        && data.description is string && data.description.size() <= 10000
        && weddingDate(data.eventDate) && weddingDate(data.plannedDate)
        && ((data.status == 'completed' && data.eventDate != null) || (data.status == 'upcoming' && data.eventDate == null))
        && data.type in ['proposal', 'family', 'rings', 'engagement', 'home', 'planning', 'event', 'katb_ketab', 'henna', 'wedding', 'honeymoon', 'other']
        && data.createdByUid in ['xLUPD71OGYfG4NByDz0buh8ZIsy2', 'orPQHip5ooOtfSSkyLYhl5hx9Kg1']
        && data.createdByName == weddingName(data.createdByUid)
        && weddingPhotos(data.photos, id) && weddingNotes(data.notesByUid)
        && data.deleting is bool && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /couples/{coupleId} {
      allow read: if allowedUser();

      match /weddingTimeline/{momentId} {
        allow read: if allowedUser() && coupleId == 'yushef';
        allow create: if allowedUser() && coupleId == 'yushef'
          && validWeddingMoment(request.resource.data, momentId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.deleting == false && request.resource.data.photos.size() == 0
          && request.resource.data.notesByUid.keys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.notesByUid)
            || request.resource.data.notesByUid[request.auth.uid].updatedAt == request.time);
        allow update: if allowedUser() && coupleId == 'yushef'
          && validWeddingMoment(request.resource.data, momentId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.notesByUid.diff(resource.data.notesByUid).affectedKeys().hasOnly([request.auth.uid])
          && (!request.resource.data.notesByUid.diff(resource.data.notesByUid).affectedKeys().hasAny([request.auth.uid])
            || !(request.auth.uid in request.resource.data.notesByUid)
            || request.resource.data.notesByUid[request.auth.uid].updatedAt == request.time)
          && ((resource.data.deleting == false && request.resource.data.deleting == false)
            || (request.resource.data.deleting == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting', 'updatedAt'])));
        allow delete: if allowedUser() && coupleId == 'yushef' && resource.data.deleting == true;
      }

      match /monthversaries/{memoryId} {
        allow read, create, update, delete: if allowedUser();
      }

      match /nudges/{nudgeId} {
        allow read: if allowedUser();
        allow create: if allowedUser()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.toUserId in [
            "xLUPD71OGYfG4NByDz0buh8ZIsy2",
            "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
          ]
          && request.resource.data.toUserId != request.auth.uid;
        allow update: if allowedUser()
          && resource.data.toUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
        allow delete: if false;
      }

      match /suggestions/{suggestionId} {
        allow read: if allowedUser();
        allow create: if allowedUser()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0;
        allow update: if allowedUser()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "likedBy",
            "done",
            "doneAt"
          ]);
        allow delete: if allowedUser()
          && resource.data.createdBy == request.auth.uid;
      }

      match /theaterItems/{itemId} {
        allow read: if allowedUser();
        allow create: if allowedUser()
          && request.resource.data.addedByUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
        allow update, delete: if allowedUser();

        match /comments/{commentId} {
          allow read: if allowedUser();
          allow create: if allowedUser()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0;
          allow update: if allowedUser()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid;
          allow delete: if allowedUser()
            && resource.data.uid == request.auth.uid;
        }
      }

      match /theaterSession/{sessionId} {
        allow read: if allowedUser();
        allow create: if allowedUser()
          && request.resource.data.get("readyUsers", {}).keys().hasOnly([request.auth.uid])
          && validOwnTheaterReadiness(request.resource.data);
        allow update: if allowedUser()
          && request.resource.data.get("readyUsers", {})
            .diff(resource.data.get("readyUsers", {}))
            .affectedKeys()
            .hasOnly([request.auth.uid])
          && validOwnTheaterReadiness(request.resource.data);
        allow delete: if allowedUser();
      }

      match /games/{gameId} {
        allow read: if allowedUser();

        match /rounds/{roundId} {
          allow read: if allowedUser();
          allow create: if allowedUser()
            && request.resource.data.createdByUid == request.auth.uid;
          allow update: if allowedUser()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "players",
              "status",
              "currentTurnUid",
              "updatedAt"
            ]);
          allow delete: if allowedUser();

          match /secrets/{userId} {
            allow read, delete: if allowedUser()
              && request.auth.uid == userId;
            allow create, update: if allowedUser()
              && request.auth.uid == userId
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.secretNumber is string
              && request.resource.data.secretNumber.matches("^[0-9]{4}$");
          }

          match /guesses/{guessId} {
            allow read: if allowedUser();
            allow create, update, delete: if false;
          }
        }

        match /scores/{userId} {
          allow read: if allowedUser();
          allow create, update: if allowedUser()
            && userId in [
              "xLUPD71OGYfG4NByDz0buh8ZIsy2",
              "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
            ]
            && request.resource.data.keys().hasOnly([
              "uid",
              "name",
              "wins",
              "losses",
              "roundsPlayed",
              "totalGuesses",
              "bestWinAttempts",
              "updatedAt"
            ])
            && request.resource.data.uid == userId
            && request.resource.data.name is string
            && request.resource.data.wins == 0
            && request.resource.data.losses == 0
            && request.resource.data.roundsPlayed == 0
            && request.resource.data.totalGuesses == 0
            && request.resource.data.bestWinAttempts == null;
          allow delete: if false;
        }
      }

      match /letters/{letterId} {
        allow get: if allowedUser()
          && apologyLetterScope(coupleId, letterId)
          && (
            request.auth.uid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
            || (
              request.auth.uid == "xLUPD71OGYfG4NByDz0buh8ZIsy2"
              && resource.data.status == "published"
              && resource.data.fromUid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
              && resource.data.toUid == "xLUPD71OGYfG4NByDz0buh8ZIsy2"
            )
          );
        allow list: if false;
        allow create: if allowedUser()
          && apologyLetterScope(coupleId, letterId)
          && request.auth.uid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
          && validApologyDraft(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if allowedUser()
          && apologyLetterScope(coupleId, letterId)
          && request.auth.uid == "orPQHip5ooOtfSSkyLYhl5hx9Kg1"
          && resource.data.status == "draft"
          && validApologyDraft(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /letterPublications/{letterId} {
        allow get: if allowedUser()
          && apologyLetterScope(coupleId, letterId)
          && request.auth.uid == "xLUPD71OGYfG4NByDz0buh8ZIsy2";
        allow list, create, update, delete: if false;
      }

      match /special19ths/{eventId} {
        allow read: if allowedUser() && special19thScope(coupleId, eventId);
        allow create: if allowedUser()
          && special19thScope(coupleId, eventId)
          && validInitialSpecial19thEvent(request.resource.data);
        allow update, delete: if false;

        match /packages/{userId} {
          allow read: if allowedUser()
            && special19thScope(coupleId, eventId)
            && (
              request.auth.uid == userId
              || special19thRevealReached(coupleId, eventId)
            );
          allow create: if allowedUser()
            && special19thScope(coupleId, eventId)
            && request.auth.uid == userId
            && special19thEventExists(coupleId, eventId)
            && special19thRevealNotStarted(coupleId, eventId)
            && validSpecial19thDraft(
              request.resource.data,
              coupleId,
              eventId,
              userId
            )
            && request.resource.data.createdAt == request.time;
          allow update: if allowedUser()
            && special19thScope(coupleId, eventId)
            && request.auth.uid == userId
            && resource.data.ownerUid == userId
            && resource.data.sealed == false
            && special19thRevealNotStarted(coupleId, eventId)
            && validSpecial19thDraft(
              request.resource.data,
              coupleId,
              eventId,
              userId
            )
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }

        match /presence/{userId} {
          allow read: if allowedUser() && special19thScope(coupleId, eventId);
          allow create, update: if allowedUser()
            && special19thScope(coupleId, eventId)
            && special19thEventExists(coupleId, eventId)
            && request.auth.uid == userId
            && validSpecial19thPresence(request.resource.data, userId);
          allow delete: if false;
        }

        match /momentPhotos/{userId} {
          allow read: if allowedUser()
            && special19thScope(coupleId, eventId)
            && special19thRevealReached(coupleId, eventId);
          allow create: if allowedUser()
            && special19thScope(coupleId, eventId)
            && request.auth.uid == userId
            && special19thRevealReached(coupleId, eventId)
            && validSpecial19thMoment(
              request.resource.data,
              coupleId,
              eventId,
              userId
            )
            && request.resource.data.submittedAt == request.time;
          allow update: if allowedUser()
            && special19thScope(coupleId, eventId)
            && request.auth.uid == userId
            && resource.data.uid == userId
            && special19thRevealReached(coupleId, eventId)
            && otherSpecial19thMomentMissing(coupleId, eventId, userId)
            && validSpecial19thMoment(
              request.resource.data,
              coupleId,
              eventId,
              userId
            )
            && request.resource.data.submittedAt == resource.data.submittedAt;
          allow delete: if false;
        }
      }

      match /notificationTokens/{userId}/tokens/{tokenId} {
        allow read, create, update, delete: if allowedUser()
          && request.auth.uid == userId;
      }
    }
  }
}
